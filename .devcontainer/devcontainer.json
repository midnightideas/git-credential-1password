{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "Anthropic.claude-code",
                "GitHub.copilot-chat",
                "mhutchie.git-graph",
                "ue.alphabetical-sorter"
            ],
            "settings": {
                "remote.autoForwardPorts": false,
                "terminal.integrated.profiles.linux": {
                    "Claude Code": {
                        "args": [
                            "-c",
                            "command -v agent-env >/dev/null 2>&1 && exec agent-env claude || exec claude"
                        ],
                        "icon": "claude",
                        "path": "/bin/sh"
                    },
                    "GitHub Copilot CLI": null
                }
            }
        }
    },
    "features": {
        "ghcr.io/tailscale/codespace/tailscale": {}
    },
    "overrideCommand": true,
    "postAttachCommand": "exec /usr/local/bin/postAttachCommand.sh",
    "runArgs": [
        "--env-file=${localEnv:HOME}/.devcontainer.env"
    ]
}
